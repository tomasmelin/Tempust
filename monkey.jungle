project.manifest = manifest.xml

# Default source path (source/**) already matches this project's
# layout. Resource path is spelled out explicitly (rather than left
# implicit) because the per-device lines below need $(base.resourcePath)
# to build on. See LOCAL_SETUP.md if you want to understand what this
# file is for in general.
base.resourcePath = resources

# Per-device launcher icon overrides.
#
# The base drawables (resources/drawables/launcher_icon.png) are 80x80
# and get auto-scaled by the resource compiler for every device - that
# works fine functionally, but produces a build-time warning for every
# device whose actual launcher icon slot isn't 80x80 (nearly all of
# them; sizes range from 26x26 to 70x70 across this app's device list).
#
# These lines route each device to a resources-icon<W>x<H>/ folder
# containing a pre-sized launcher_icon.png at its exact slot size,
# eliminating the warning. Generated from each device's "Launcher Icon
# Size" (Device Reference docs) - if you add a new product id to
# manifest.xml, either add a matching line here (check its icon size in
# the Connect IQ device reference) or accept the harmless warning for
# it.
approachs50.resourcePath = $(base.resourcePath);resources-icon56x56
approachs7042mm.resourcePath = $(base.resourcePath);resources-icon60x60
approachs7047mm.resourcePath = $(base.resourcePath);resources-icon70x70
d2air.resourcePath = $(base.resourcePath);resources-icon60x60
d2airx10.resourcePath = $(base.resourcePath);resources-icon70x70
