<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="TempustApp" id="1de83b78-c0ce-40c0-b717-0f98fdb37f48" launcherIcon="@Drawables.LauncherIcon" minSdkVersion="4.2.0" name="@Strings.AppName" type="widget" version="1.0.0">
        <!--
            NOTE: replace the placeholder "id" above with the real UUID
            that the Connect IQ SDK generates automatically when you
            create the project via "Connect IQ: New Project" in VS Code
            (see README).
        -->
        <!--
            Broad list of current GPS-capable, Connect IQ 4+ devices
            that support the Positioning + Communications permissions
            this app needs (running/multisport watches only - plain
            activity trackers without GPS are intentionally excluded,
            since the app can't function on them).

            IMPORTANT: Garmin adds new watches and occasionally tweaks
            product-id strings over time, and the SDK validates every
            id against its own device database at build time (an
            unknown id fails the build, so nothing here can "silently"
            break). Before publishing, open this project in the VS
            Code Monkey C extension and use "Edit Compatible Devices" /
            the device picker in the export wizard to confirm this
            list against the current full catalog and add anything
            new - that UI is the authoritative source, this list is a
            solid starting point, not the final word.
        -->
        <iq:products>
            <!-- Forerunner -->
            <!--
        fenix - every fenix7/8-generation id in the installed SDK's
        device database as of this writing, including fenix E, plus
        the no-WiFi 7 Pro variants. Bare ids like "fenix6x" or "fenix8"
        don't exist in this SDK - Garmin splits by size/material
        instead (fenix6xpro, fenix843mm/847mm, etc.).

        fenix3, fenix3_hr, fenix5-family, fenix6-family and fenix
        Chronos are NOT included: the compiler hard-errors on them -
        "Device 'fenixN' does not support API Level '4.2.0'" - because
        those devices predate this app's minSdkVersion (set above).
        To add them back you'd need to lower minSdkVersion project-wide
        (affecting every device here, not just these) and re-verify
        every API this app uses is actually available that far back -
        deliberately not done here without that check. tactix/quatix/
        enduro share hardware with several fenix generations but are
        intentionally left out here too - they're their own product
        line, add them separately if you want to support them.
    -->
            <!-- epix / MARQ -->
            <!-- vivoactive / Venu -->
            <!-- Descent (dive computers, also used for general GPS wear) -->
            <iq:product id="epix2"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7xpronowifi"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenixe"/>
            <iq:product id="fr255"/>
            <iq:product id="fr255s"/>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="marq2"/>
            <iq:product id="venu2"/>
            <iq:product id="venu2plus"/>
            <iq:product id="venu2s"/>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
            <iq:product id="vivoactive5"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>