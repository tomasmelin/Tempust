<strings>
    <string id="AppName">Tempust</string>

    <!-- UI labels -->
    <string id="HintRefresh">SELECT = refresh</string>
    <!-- scope="glance": also loaded by TempustGlanceView, not just the
         full widget view - resources default to foreground-only, so
         without this the glance crashes trying to access it (Rez
         symbols are scoped per resource, independently of the :glance
         code annotation). See Core Topics > Resources > Resource
         Scopes in the Connect IQ SDK docs. -->
    <string id="UnknownStation" scope="glance">Unknown station</string>

    <!-- Status messages shown while fetching / on error -->
    <string id="StatusPromptRefresh">Press SELECT to fetch</string>
    <string id="StatusLocating" scope="glance">Locating...</string>
    <string id="StatusFetching">Fetching temperature...</string>
    <string id="StatusNoPosition" scope="glance">No GPS position yet</string>
    <string id="StatusNoStation" scope="glance">No nearby station found</string>
    <string id="StatusErrorPrefix">Error (code </string>
    <string id="StatusErrorSuffix">)</string>
    <!-- Shown in the glance row on network error - no room there for
         the code-specific "Error (code NNN)" the full widget shows. -->
    <string id="GlanceError" scope="glance">Error</string>

    <!-- Settings (Garmin Connect Mobile > device > App Settings > Tempust) -->
    <string id="TempUnitTitle">Temperature unit</string>
    <string id="TempUnitCelsius">Celsius (°C)</string>
    <string id="TempUnitFahrenheit">Fahrenheit (°F)</string>

    <!-- Easter egg: tap SELECT 5 times quickly. See README. -->
    <string id="EasterEggTitle">SAUNA MODE UNLOCKED</string>
    <string id="EasterEggNoData">Get a real reading first, hero.</string>
    <string id="EasterEggPrefix">You're </string>
    <string id="EasterEggSuffix"> from an 80°C sauna.</string>
    <string id="EasterEggFooter">Bring a towel.</string>
</strings>
